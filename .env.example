# Copy to .env and fill in. Never commit the real .env file.

# MLflow tracking (local file store by default; point to a remote server if you stand one up)
MLFLOW_TRACKING_URI=./mlruns

# Kaggle API credentials, needed once to download the M5 dataset (see docs/architecture.md)
KAGGLE_USERNAME=
KAGGLE_KEY=

# Dagster home (local run/event storage)
DAGSTER_HOME=./.dagster_home

# API
DSP_API_HOST=0.0.0.0
DSP_API_PORT=8000
