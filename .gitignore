# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# --- Env / secrets ---
.env
*.pem

# --- Data (never commit raw/derived data, only code that produces it) ---
data/raw/*
data/bronze/*
data/silver/*
data/gold/*
!data/raw/.gitkeep
!data/bronze/.gitkeep
!data/silver/.gitkeep
!data/gold/.gitkeep
*.parquet
*.csv
!tests/**/*.csv

# --- MLflow / experiment artifacts ---
mlruns/
mlartifacts/

# --- Dagster ---
.dagster_home/

# --- OS / IDE ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- GCP credentials ---
gcp-key.json
*-service-account*.json
service-account*.json
